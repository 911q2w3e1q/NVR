<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 相机：SurfaceView，系统直接渲染 -->
    <SurfaceView
        android:id="@+id/camera_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 小人叠加层 -->
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#CC000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:text="NVR\n点此切日志/校准" />

    <!-- 右下角：模型操作。列表来自自动扫描结果，无需写死模型 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="14dp"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/btn_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC43A047"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="8dp"
            android:text="导入模型" />

        <Button
            android:id="@+id/btn_switch_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#CC1E88E5"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="8dp"
            android:text="切换模型" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/diag_scroll"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:background="#E6000000"
        android:scrollbars="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/diag_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#7CFC00"
            android:textSize="11sp"
            android:typeface="monospace"
            android:text="日志" />
    </ScrollView>

</FrameLayout>
